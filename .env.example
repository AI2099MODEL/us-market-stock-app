# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY
# DHAN_API_KEY: Required for Dhan primary Indian commodity trading API.
DHAN_API_KEY=MY_DHAN_API_KEY
# DHAN_CLIENT_ID: Required for Dhan API authentication.
DHAN_CLIENT_ID=MY_DHAN_CLIENT_ID
# DHAN_ACCESS_TOKEN: Required for Dhan live market feed & order execution.
DHAN_ACCESS_TOKEN=MY_DHAN_ACCESS_TOKEN

# SUPABASE_URL: Your Supabase project URL
SUPABASE_URL=MY_SUPABASE_URL
# SUPABASE_KEY: Your Supabase anon key
SUPABASE_KEY=MY_SUPABASE_KEY

# SHOONYA API Credentials for Live Data & Trading
SHOONYA_USER_ID=MY_SHOONYA_USER_ID
SHOONYA_PASSWORD=MY_SHOONYA_PASSWORD
SHOONYA_VENDOR_CODE=MY_SHOONYA_VENDOR_CODE
SHOONYA_API_KEY=MY_SHOONYA_API_KEY
SHOONYA_IMEI=MY_SHOONYA_IMEI
SHOONYA_TOTP_SECRET=MY_SHOONYA_TOTP_SECRET
